# ============================================================
#  Copy this file to ".env.local" and fill in the values.
#  NEVER share .env.local or upload it anywhere public.
#  See README → "Environment variables" for where to find each one.
# ============================================================

# --- Supabase (Project Settings → API Keys, and "Connect") ---
# Your project's address, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The PUBLISHABLE key (starts with sb_publishable_). Safe to use in the browser.
# (Older projects: use the "anon" key here instead.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The SECRET key (starts with sb_secret_). Server only. Keep it private!
# (Older projects: use the "service_role" key here instead.)
SUPABASE_SECRET_KEY=

# Database connection string, used only by "npm run db:migrate".
# Supabase → Connect → Session pooler. Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=

# --- App ---
# The address people use to reach the app. Leave empty on your computer.
# On Vercel, set it to your real domain, e.g. https://app.yourbrand.com
NEXT_PUBLIC_SITE_URL=

# --- Email (Resend) — needed from Phase 3 for app notifications ---
RESEND_API_KEY=

# --- Platform admin ---
# Emails of Harbor's own admins (you), comma separated. Only these can open /admin.
# They must sign in with that email, confirm it, and use two-step sign-in.
PLATFORM_ADMIN_EMAILS=abyan@nuit.works
